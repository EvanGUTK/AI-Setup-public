#!/bin/bash
# Fake sw_vers for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
case "$1" in
  -productVersion) echo "14.5";;
  *) printf 'ProductName:\tmacOS\nProductVersion:\t14.5\nBuildVersion:\t23F79\n';;
esac
