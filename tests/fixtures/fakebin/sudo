#!/bin/bash
# Fake sudo for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
[ -n "$FAKE_SUDO_FAIL" ] && exit 1
while [ $# -gt 0 ]; do case "$1" in -*) shift;; *) break;; esac; done
[ $# -gt 0 ] && command -v "$1" >/dev/null 2>&1 && exec "$@"
exit 0
