#!/bin/bash
# Fake claude for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
case "$1 $2" in
  "plugin list"|"plugins list") printf '%s\n' "${FAKE_CLAUDE_PLUGINS:-}"; exit 0;;
  "auth status") exit "${FAKE_CLAUDE_AUTH:-0}";;
esac
case "$1" in --version|-v) echo "2.0.0 (Claude Code, fake)";; esac
exit 0
