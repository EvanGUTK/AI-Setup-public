#!/bin/bash
# Fake wslpath for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
case "$1" in
  -w) printf 'C:\\Users\\%s\n' "${FAKE_WIN_USER:-tester}";;
  *)  echo "${FAKE_WIN_HOME:-/mnt/c/Users/${FAKE_WIN_USER:-tester}}";;
esac
