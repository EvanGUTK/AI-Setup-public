#!/bin/bash
# Fake gh for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
case "$1 $2" in
  "auth status") echo "fake gh auth status"; exit "${FAKE_GH_AUTH:-1}";;
esac
case "$1" in --version) echo "gh version 2.50.0 (fake)";; esac
exit 0
