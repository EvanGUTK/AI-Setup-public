#!/bin/bash
# Fake uname for tests/test_install.py: logs argv to $FAKE_LOG; behaviour driven by FAKE_* env vars.
printf "%s %s\n" "${0##*/}" "$*" >> "${FAKE_LOG:-/dev/null}"
case "$1" in
  -r) echo "${FAKE_UNAME_R:-6.1.0-generic}";;
  -m) echo "${FAKE_UNAME_M:-x86_64}";;
  -a) echo "${FAKE_UNAME_S:-Linux} fakehost ${FAKE_UNAME_R:-6.1.0-generic} #1 ${FAKE_UNAME_M:-x86_64}";;
  -n) echo fakehost;;
  *)  echo "${FAKE_UNAME_S:-Linux}";;
esac
